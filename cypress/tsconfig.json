{
	"include": ["**/*.ts", "../cypress.d.ts"],
	"compilerOptions": {
		"target": "es2024",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "es2022",
		"moduleResolution": "node",
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowJs": true,
		"types": ["cypress", "node"]
	}
}
