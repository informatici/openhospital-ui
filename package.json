		"@types/pdfmake": "^0.2.12",
		"@types/react": "^19.2.7",
		"@types/react-csv": "^1.1.10",
		"@types/react-dom": "^19.2.3",
		"@types/react-grid-layout": "^1.3.6",
		"@types/sass": "^1.45.0",
		"@types/testing-library__jest-dom": "^6.0.0",
		"@types/testing-library__react": "^10.2.0",
		"@types/yup": "^0.32.0",
		"@vitejs/plugin-react": "^5.1.2",
		"cypress": "^15.7.1",
