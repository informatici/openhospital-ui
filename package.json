	"scripts": {
		"transifex:source": "node scripts/transifex/syncSource.js",
		"transifex:files": "node scripts/transifex/syncFiles.js",
		"start": "vite dev",
		"dev": "vite",
		"preview": "vite preview",
		"build": "tsc --noEmit && vite build",
		"test": "vite test",
		"e2e": "start-server-and-test http://localhost:5173 cypress:open",
		"cypress:open": "cypress open",
		"build:staging": "env-cmd -f .env.staging npm run build",
		"build:prod": "env-cmd -f .env.prod npm run build",
		"build:gh-pages": "env-cmd -f .env.gh-pages npm run build",
		"build:api": "openapi-generator-cli generate -i api/oh.yaml -g typescript-rxjs -c openapi-generator.config.json -o src/generated/",
		"openapi-ts": "bun codegen.ts",
		"codegen": "bun build:api && bun openapi-ts",
		"clear": "rm -rf ./.cache ./dist ./build",
		"convert": "convert-resources --path-generated src/resources/old",
		"storybook": "storybook dev -p 6006 -s public",
		"build-storybook": "storybook build -s public",
		"tsc": "tsc --noEmit",
		"check": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint",
		"postinstall": "npm run build:api"
	},
	"eslintConfig": {
		"extends": "react-app",
		"overrides": [
			{
				"files": [
					"**/*.stories.*"
				],
				"rules": {
					"import/no-anonymous-default-export": "off"
				}
			}
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@msw/data": "^1.1.2",
		"@openapitools/openapi-generator-cli": "2.25.2",
		"@storybook/addon-actions": "^9.0.8",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/addon-interactions": "^8.6.14",
		"@storybook/addon-links": "^10.1.8",
		"@storybook/node-logger": "^8.6.14",
		"@storybook/preset-create-react-app": "^10.1.8",
		"@storybook/react": "^10.1.8",
		"@storybook/testing-library": "^0.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/classnames": "^2.3.4",
		"@types/jest": "^30.0.0",
		"@types/jquery": "^3.5.33",
		"@types/lodash": "^4.17.21",
		"@types/node": "^25.0.2",
